{
    "python.analysis.autoSearchPaths": false,
    // bpy/ and modules/ resolve through extraPaths; excluding them stops Pylance
    // from treating the 9 MB of fake-bpy-module stubs as project source.
    "python.analysis.exclude": [
        "**/__pycache__",
        "**/.git",
        "bpy",
        "modules",
        "config",
    ],
    // stubs opened via Go to Definition are still checked like open source files;
    // ignore suppresses their diagnostics
    "python.analysis.ignore": [
        "bpy",
        "modules",
    ],
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.packageIndexDepths": [
        { "name": "bpy", "depth": 2 },
    ],
    // python.analysis.nodeExecutable is machine-scoped and only works in user
    // settings; set it there to run Pylance with a larger heap
    "python.analysis.extraPaths": [
        "${workspaceFolder}/bpy",
        "${workspaceFolder}/modules",
        "${workspaceFolder}/src",
    ],
    "python.analysis.typeCheckingMode": "strict",
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingModuleSource": "none",
        "reportUnusedExpression": "none",
        "reportOptionalMemberAccess": "warning",
        "reportOptionalSubscript": "warning",
        "reportOptionalIterable": "warning",
        "reportImportCycles": "warning",
        "reportMissingParameterType": "none",
        "reportUnnecessaryComparison": "information",
        "reportUnnecessaryIsInstance": "information",
        "reportUnnecessaryCast": "information",
        "reportUnusedVariable": "information",
        "reportUnusedImport": "information",
        "reportUnusedFunction": "information",
        "reportUnusedClass": "information"
    },
}