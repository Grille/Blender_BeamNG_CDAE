{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Setup Workspace",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/setup.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Build Addon",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/build.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Attach to Blender",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "justMyCode": false
        }
    ]
}